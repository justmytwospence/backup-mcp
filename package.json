{
  "name": "backup-mcp",
  "version": "0.2.0",
  "description": "MCP server that re-runs docker-volume-backup and stack-back jobs on demand, and nothing else",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "backup-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "test": "npm run build && node --test dist/*.test.js",
    "clean": "rm -rf dist",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/hono": "^2.0.2",
    "@modelcontextprotocol/server": "^2.3.0",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
